# Copy this file to .env and fill in real values. Never commit the real .env file.

SECRET_KEY=replace-with-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=

TIME_ZONE=Asia/Kolkata

# Contact form -> where new leads get emailed
CONTACT_RECEIVER_EMAIL=vivkverma905@gmail.com

# Email sending -- Resend (HTTPS API) is preferred when RESEND_API_KEY is
# set; SMTP below is only a fallback for local dev / hosts that don't block
# outbound SMTP. See README "Receiving contact-form emails".
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_TIMEOUT=10
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
